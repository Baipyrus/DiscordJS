{
	"name": "discordjs",
	"version": "0.0.1",
	"description": "",
	"private": true,
	"type": "module",
	"bin": {
		"discordjs": "./build/index.js"
	},
	"scripts": {
		"deploy": "NODE_ENV=development tsx --env-file=.env src/lib/deploy.ts",
		"dev": "NODE_ENV=development tsx --env-file=.env src/index.ts",
		"dev:watch": "NODE_ENV=development tsx watch --env-file=.env src/index.ts",
		"build": "tsup && chmod +x build/index.js",
		"prod": "NODE_ENV=production exec node --env-file=.env build/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@libsql/client": "0.18.0",
		"discord.js": "14.27.0",
		"drizzle-orm": "0.45.4",
		"winston": "3.19.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.5",
		"drizzle-kit": "0.31.11",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.9.10",
		"tsc-alias": "1.9.9",
		"tsup": "9.0.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"typescript-eslint": "8.72.1"
	}
}
